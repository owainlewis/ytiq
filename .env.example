# Get a key: Google Cloud Console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# Optional
YTIQ_DB_PATH=data/ytiq.db
YTIQ_STARTUP_SKIP_HOURS=1
# Analyze button. Transcripts: https://supadata.ai (free tier: 100/month). Analysis: https://console.anthropic.com
SUPADATA_API_KEY=
ANTHROPIC_API_KEY=
